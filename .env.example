# GitHub Personal Access Token (Fine-grained or classic with 'repo' / 'actions:write' scope)
GH_DISPATCH_TOKEN=ghp_your_token_here

# GitHub repository target in format owner/repo (Default: bcaway/backend-sync)
GITHUB_REPO=bcaway/backend-sync

# Target git ref / branch (Default: main)
GITHUB_REF=main

# Optional shared secret to protect HTTP /trigger and /cron manual test endpoints
# If set, requests must pass ?key=SECRET or Authorization: Bearer SECRET
TRIGGER_AUTH_SECRET=
